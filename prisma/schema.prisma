generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StreamStatus {
  OFFLINE
  LIVE
}

enum VideoType {
  VOD
  RECORD
}

model Streamer {
  id           BigInt        @id @default(autoincrement())
  username     String        @unique
  streamKey    String        @unique
  title        String?
  status       StreamStatus  @default(OFFLINE)
  hlsUrl       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  videos       Video[]
  chatMessages ChatMessage[]
  
  restreamVideo String?
  
  @@map("streamers")
}

model Viewer {
  id           BigInt        @id @default(autoincrement())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  chatMessages ChatMessage[]

  @@map("viewers")
}

model Video {
  id          BigInt    @id @default(autoincrement())
  streamerId  BigInt

  title       String
  type        VideoType @default(RECORD)

  // Link HLS để frontend phát video xem lại
  // Ví dụ: http://103.6.234.179/vod-hls/minhhoang-record/index.m3u8
  hlsUrl      String

  // Đường dẫn file record gốc trên VPS, nếu có
  // Ví dụ: /var/records/minhhoang_live_key-1779292302.flv
  recordPath  String?

  // Thư mục HLS trên VPS, nếu muốn lưu để dễ debug
  // Ví dụ: /var/www/vod-hls/minhhoang-record
  vodPath     String?

  createdAt   DateTime  @default(now())

  streamer    Streamer  @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@index([streamerId])
  @@map("videos")
}

model ChatMessage {
  id         BigInt   @id @default(autoincrement())
  streamerId BigInt
  viewerId   BigInt
  message    String
  createdAt  DateTime @default(now())
  streamer   Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  viewer     Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([streamerId])
  @@index([viewerId])
  @@map("chat_messages")
}
